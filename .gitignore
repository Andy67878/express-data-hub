<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>E’Xpress Data Bundle Hub</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Sora:wght@700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef3ff;--ink:#0b1b3f;--mut:#51628a;--panel:#fff;--line:#d5def5;--hd:#f7f9ff;--navy:#071b45;--royal:#0a3d91;--gold:#ffc21a;--red:#e11d2e;--wa:#15a04a;--f1:Sora,"Segoe UI",system-ui,sans-serif;--f2:Manrope,system-ui,-apple-system,"Segoe UI",sans-serif;color-scheme:light dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#061330;--ink:#eaf0ff;--mut:#9fb2e0;--panel:#0d2250;--line:#1c3770;--hd:#071b45}}
:root[data-theme="dark"]{--bg:#061330;--ink:#eaf0ff;--mut:#9fb2e0;--panel:#0d2250;--line:#1c3770;--hd:#071b45}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f2);line-height:1.5;font-size:16px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--navy);z-index:20}
a{color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.wrap{max-width:860px;margin:0 auto;padding:0 18px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:19;background:var(--navy);color:#fff;border-bottom:1px solid #ffffff1f}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:60px}
.brand{display:flex;align-items:center;gap:10px;font:800 19px var(--f1);font-style:italic;letter-spacing:-.01em;text-decoration:none}
.brand img{width:38px;height:38px;border-radius:50%}
.brand span{color:var(--gold)}
.call{background:var(--gold);color:#1d1400;text-decoration:none;font-weight:800;font-size:14px;padding:9px 16px;border-radius:30px}
.hero{position:relative;overflow:hidden;color:#fff;background:radial-gradient(120% 90% at 85% 0,#1356c4 0,#0a3d91 35%,#071b45 75%);padding:44px 0 74px}
.streaks{position:absolute;inset:0;pointer-events:none}
.streaks i{position:absolute;left:0;height:7px;border-radius:0 8px 8px 0;background:linear-gradient(90deg,#fff0,#fff);opacity:.2;animation:sl 1.2s cubic-bezier(.16,.8,.2,1) both;animation-delay:var(--d)}
@keyframes sl{from{transform:translateX(-110%)}to{transform:none}}
.hero .wrap{position:relative}
.mark{width:112px;height:112px;border-radius:50%;padding:5px;background:linear-gradient(145deg,var(--gold),#ff7a1a);box-shadow:0 0 0 7px #ffc21a29,0 18px 40px #0008;margin-bottom:24px}
.mark img{width:100%;height:100%;border-radius:50%;display:block}
h1{font:800 clamp(34px,9.5vw,62px)/1.02 var(--f1);letter-spacing:-.025em;margin:0 0 16px;max-width:12em}
h1 em{font-style:normal;color:var(--gold)}
.hero p{font-size:18px;max-width:30em;margin:0 0 24px;color:#d6e2ff}
.cta{display:flex;gap:10px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 24px;border-radius:30px;font:800 16px var(--f2);text-decoration:none;border:2px solid transparent;min-height:48px}
.wa{background:var(--wa);color:#fff;box-shadow:0 8px 22px #15a04a66}
.ph{border-color:#ffffff66;color:#fff}
.trust{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:26px;font-weight:700;font-size:14px;color:#cfdcff}
.trust span::before{content:"✓";color:var(--gold);margin-right:6px;font-weight:900}
main{margin-top:-40px;position:relative}
.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:5px;box-shadow:0 14px 34px #0a1b4a33}
.tab{border:0;background:transparent;color:var(--ink);font:800 16px var(--f1);padding:14px 4px;border-radius:15px;cursor:pointer;transition:background .2s,color .2s}
.num{display:flex;align-items:center;gap:10px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:6px 16px;margin:14px 0 6px}
.num label{font-weight:700;font-size:14px;color:var(--mut);white-space:nowrap}
.num input{flex:1;min-width:0;border:0;background:transparent;color:var(--ink);font:800 18px var(--f1);padding:10px 0;outline:none}
.num:focus-within{border-color:var(--gold);box-shadow:0 0 0 3px #ffc21a40}
.hint{font-size:13px;color:var(--mut);margin:0 4px 14px}
.list{display:grid;gap:8px}
.row{display:grid;grid-template-columns:70px 1fr auto;align-items:center;gap:12px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:12px 14px;text-decoration:none;position:relative;transition:transform .15s,border-color .15s}
.row:hover{transform:translateX(3px);border-color:var(--nc)}
.row:active{transform:scale(.985)}
.gb{font:800 28px/1 var(--f1);letter-spacing:-.03em}.gb small{font-size:13px;margin-left:2px;color:var(--mut)}
.bar{height:8px;background:var(--line);border-radius:6px;overflow:hidden;margin-bottom:6px}
.bar b{display:block;height:100%;background:linear-gradient(90deg,#fff0,var(--nc));clip-path:polygon(0 0,100% 0,96% 100%,0 100%)}
.meta{font-size:12.5px;color:var(--mut);font-weight:600}
.best{background:var(--gold);color:#241800;font-weight:800;font-size:11px;padding:2px 8px;border-radius:20px;margin-left:6px}
.buy{text-align:right}.buy strong{display:block;font:800 19px var(--f1);color:var(--ink)}
.buy i{display:inline-block;margin-top:4px;font-style:normal;font-weight:800;font-size:12px;background:var(--wa);color:#fff;padding:5px 12px;border-radius:20px}
h2{font:800 clamp(24px,6vw,32px)/1.1 var(--f1);letter-spacing:-.02em;margin:46px 0 16px}
.steps{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));list-style:none;padding:0;margin:0;counter-reset:s}
.steps li{counter-increment:s;padding-left:54px;position:relative;font-weight:600}
.steps li::before{content:counter(s);position:absolute;left:0;top:0;width:40px;height:40px;border-radius:50%;background:var(--royal);color:#fff;font:800 18px var(--f1);display:grid;place-items:center;box-shadow:0 0 0 4px #0a3d9133}
.contact{margin:46px 0 30px;border-radius:26px;padding:30px 22px;color:#fff;background:linear-gradient(135deg,#071b45,#0a3d91);position:relative;overflow:hidden}
.contact::after{content:"";position:absolute;right:-30px;top:30px;width:240px;height:9px;background:linear-gradient(90deg,#fff0,#ffffff55);border-radius:6px;box-shadow:-40px 22px 0 #ffffff2e,-10px 44px 0 #ffffff22}
.contact h2{margin:0 0 6px;font-size:26px}
.contact .n{display:block;font:800 clamp(32px,9vw,48px)/1.1 var(--f1);color:var(--gold);text-decoration:none;margin:4px 0 18px;letter-spacing:-.02em}
footer{text-align:center;color:var(--mut);font-size:13px;padding:6px 18px 96px}
footer img{width:44px;height:44px;border-radius:50%;display:block;margin:0 auto 10px}
.fab{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));width:58px;height:58px;border-radius:50%;background:var(--wa);display:grid;place-items:center;box-shadow:0 8px 22px #0007;z-index:18;text-decoration:none}
.fab svg{width:30px;height:30px;fill:#fff}
@media (prefers-reduced-motion:reduce){.streaks i{animation:none}html{scroll-behavior:auto}*{transition:none!important}}
@media (min-width:640px){.row{grid-template-columns:100px 1fr 150px;padding:14px 20px}.gb{font-size:34px}}
</style></head><body>
<header><div class="wrap"><a class="brand" href="#top"><img class="lg" alt="">E’XPRESS <span>Hub</span></a><a class="call" href="tel:+233599994449">Call now</a></div></header>
<section class="hero" id="top"><div class="streaks" aria-hidden="true">
<i style="top:8%;width:52%;--d:0s"></i><i style="top:15%;width:30%;--d:.08s"></i><i style="top:24%;width:68%;--d:.16s"></i><i style="top:36%;width:40%;--d:.05s"></i><i style="top:52%;width:58%;--d:.2s"></i><i style="top:64%;width:34%;--d:.12s"></i><i style="top:76%;width:72%;--d:.24s"></i><i style="top:88%;width:46%;--d:.1s"></i></div>
<div class="wrap"><div class="mark"><img class="lg" alt="E’Xpress Data Bundle Hub logo"></div>
<h1>Buy affordable data. <em>Get it fast.</em></h1>
<p>MTN, AT and Telecel bundles from 1GB to 100GB. Pick a bundle and order on WhatsApp in seconds.</p>
<div class="cta"><a class="btn wa" id="hero-wa" target="_blank" rel="noopener">Order on WhatsApp</a><a class="btn ph" href="tel:+233599994449">Call 0599994449</a></div>
<div class="trust"><span>Instant delivery</span><span>Delivery assured</span><span>Trusted service</span></div></div></section>
<main class="wrap" id="prices">
<div class="seg" id="tabs" role="tablist"></div>
<div class="num"><label for="num">Your number</label><input id="num" type="tel" inputmode="tel" placeholder="Number to receive the data" autocomplete="off"></div>
<p class="hint">Type your number once and it is added to every order message. The bar shows bundle size.</p>
<div class="list" id="list"></div>
<h2>How to order</h2>
<ol class="steps"><li>Choose your network, then tap the bundle you want.</li><li>WhatsApp opens with your order already written. Send it.</li><li>Confirm payment with the seller and get your data.</li></ol>
<section class="contact"><h2>WhatsApp or call</h2><a class="n" href="tel:+233599994449">0599994449</a><a class="btn wa" id="bar-wa" target="_blank" rel="noopener">Chat on WhatsApp</a></section>
</main>
<footer><img class="lg" alt="">E’Xpress Data Bundle Hub<br>Prices are in Ghana cedis (GHC) and may change. Please confirm when you order.</footer>
<a class="fab" id="fab" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><svg viewBox="0 0 24 24"><path d="M4 3h16a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H9.5L5 22v-4H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/></svg></a>
<script>
const LOGO='data:image/png;base64,',NUM='233599994449',$=id=>document.getElementById(id);
document.querySelectorAll('.lg').forEach(i=>i.src=LOGO);
const D={
 mtn:{n:'MTN',c:'#ffcc00',t:'#1a1200',l:[[1,6],[2,11],[3,17],[4,21],[5,26],[6,30],[8,40],[10,50],[15,70],[20,95],[25,110],[30,135],[40,175],[50,220],[100,430]]},
 at:{n:'AT',c:'#4f8dff',t:'#fff',l:[[1,6],[2,10],[3,15],[4,20],[5,24],[6,27],[7,31],[8,35],[10,45],[15,65],[20,85],[25,105],[30,120]]},
 tel:{n:'Telecel',c:'#ff3b4a',t:'#fff',l:[[10,50],[15,70],[20,95],[25,115],[30,135],[35,170],[40,185],[45,205],[50,220],[100,430]]}};
let cur='mtn';
const wa=m=>'https://wa.me/'+NUM+'?text='+encodeURIComponent(m);
function render(){
 const num=$('num').value.trim(),nd=D[cur],best=Math.min(...nd.l.map(([g,p])=>p/g));
 $('tabs').innerHTML=Object.keys(D).map(k=>'<button class="tab" role="tab" aria-selected="'+(k==cur)+'" data-k="'+k+'" style="'+(k==cur?'background:'+D[k].c+';color:'+D[k].t:'')+'">'+D[k].n+'</button>').join('');
 $('list').innerHTML=nd.l.map(([g,p])=>{const m='Hello E’Xpress Data Bundle Hub! I want to buy '+nd.n+' '+g+'GB for GHC'+p+'.'+(num?' Number to receive data: '+num:'');
  return '<a class="row" style="--nc:'+nd.c+'" target="_blank" rel="noopener" href="'+wa(m)+'"><div class="gb">'+g+'<small>GB</small></div><div><div class="bar"><b style="width:'+Math.max(8,g)+'%"></b></div><span class="meta">GHC '+(p/g).toFixed(2)+' per GB</span>'+(p/g==best?'<span class="best">Best value</span>':'')+'</div><div class="buy"><strong>GHC '+p+'</strong><i>Buy</i></div></a>'}).join('');
 document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{cur=b.dataset.k;render()});
}
const hello=wa('Hello E’Xpress Data Bundle Hub! I would like to buy a data bundle.');
['hero-wa','bar-wa','fab'].forEach(i=>$(i).href=hello);
$('num').addEventListener('input',render);
render();
</script></body></html>
